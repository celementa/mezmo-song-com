# Go-бэкенд mezmo-song.com. На сервере — /opt/mezmo-com/.env (права 600, владелец root).
# Секреты в репозиторий не кладутся: здесь только имена и безопасные значения.

PORT=8080
PUBLIC_APP_URL=https://mezmo-song.com
DATABASE_PATH=/opt/mezmo-com/data/mezmo.db
STATIC_DIR=/var/www/mezmo-song.com
# AUDIO_DIR=/opt/mezmo-com/data/audio   # по умолчанию — рядом с БД

# Подпись публичных ссылок на заказ и колбэка Kie.ai. Смена инвалидирует ссылки из писем.
WEBHOOK_SECRET=

ADMIN_USER=
ADMIN_PASS=

# UnitPay. В тестовом режиме (UNITPAY_TEST=1) — тестовый секретный ключ, суммы
# в рублях по UNITPAY_TEST_RUB_RATE; на бою — боевой ключ и UNITPAY_TEST пусто.
UNITPAY_PROJECT_ID=445942
UNITPAY_SECRET_KEY=
UNITPAY_TEST=1
UNITPAY_CURRENCY=USD
UNITPAY_TEST_RUB_RATE=85.5

# Генерация: те же ключи, что у mezmo.ru. IP сервера — в белый список Kie.ai.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
KIE_API_KEY=
AUDIO_ALLOWED_HOSTS=aiquickdraw.com,files.freemusicarchive.org

# Письма — Unisender Go (SMTP). Домен mezmo-song.com подтверждается в кабинете Go.
SMTP_HOST=smtp.go2.unisender.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@mezmo-song.com
SMTP_FROM_NAME=Mezmo
SMTP_UNISENDER_GO=true
MAIL_REPLY_TO=support@mezmo-song.com
